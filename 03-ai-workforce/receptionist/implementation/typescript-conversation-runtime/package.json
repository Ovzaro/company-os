{
  "name": "ovzaro-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "The channel-agnostic conversational operating system for Ovzaro digital employees.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist",
    "receptionist": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/receptionist.js",
    "server": "npm run build --silent && node --env-file-if-exists=.env dist/scripts/server.js",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "smoke:openai": "tsc --noEmit false --outDir /tmp/ovzaro-receptionist-smoke && node --env-file-if-exists=.env /tmp/ovzaro-receptionist-smoke/scripts/openai-smoke-test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
